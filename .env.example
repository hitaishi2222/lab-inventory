DATABASE_URL=file:./data/lab.db
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Optional: extra trusted origins (comma-separated) for previews / alternate domains.
# BETTER_AUTH_URL itself is always trusted. Required whenever the public URL
# differs from it, otherwise login fails with 403 INVALID_ORIGIN.
#TRUSTED_ORIGINS=https://preview.example.com

# --- Backups (in-process, one per lab database) ---
# The app copies each lab DB to BACKUP_DIR with SQLite's VACUUM INTO while it is
# running, so a single container is enough — no cron sidecar, no sqlite3 CLI.
# A backup is written when the newest one is older than the interval, so
# restarts do not produce extra copies. Set BACKUP_ENABLED=0 to turn it off.
#BACKUP_ENABLED=1
#BACKUP_DIR=./backups
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP=14

# --- Password reset ---
# There is no SMTP transport, so a reset link (a single-use credential) is
# printed to the server console only when this is explicitly enabled.
# It defaults to on outside NODE_ENV=production. Set it to 0 on any deployed
# instance whose logs leave the machine, and wire a real mailer in
# src/server/auth.ts instead.
#LOG_RESET_LINKS=1

# --- Two-lab mode (optional, one instance serving two separate labs) ---
# Each lab gets a fully isolated database file (own users, inventory,
# audit log, settings). When LAB2_DATABASE_URL is set, a lab selector
# appears at the bottom of the login page; otherwise it stays hidden.
#LAB1_NAME=Photonics Lab
#LAB2_DATABASE_URL=file:./data/lab2.db
#LAB2_NAME=Quantum Lab
# After enabling: npm run db:migrate && npm run db:seed && SEED_LAB=lab-2 npm run db:seed
# (creates the same admin@lab.edu / admin123 in each lab; promote/manage
# users separately per lab.)
