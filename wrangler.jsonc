{
  // Cloudflare Workers deployment of the same app. Docker stays the default:
  // `docker compose up` uses src/server/index.ts and never reads this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lab-inventory",
  "main": "src/server/entry-worker.ts",
  // Bump when you want newer runtime behaviour; keep it a deployed-past date.
  "compatibility_date": "2025-09-01",
  // Required: src/server/db uses node:async_hooks (AsyncLocalStorage) and
  // node:path. node:fs is NEVER imported from the Worker tree — it lives in
  // index.ts / labs-fs.ts, which only the Docker entry point pulls in.
  "compatibility_flags": ["nodejs_compat"],
  // `npm run build` first: the assets binding serves ./dist and answers
  // unknown paths with index.html (React Router SPA fallback), replacing
  // serveStatic() from the Node entry.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  // The primary lab's database. A Worker has no filesystem, so the `file:` lab
  // default is served from this binding (src/server/db/index.ts). Create it once
  // with `npx wrangler d1 create lab-inventory`, paste the id it prints here, then
  // apply the schema from your machine: `npm run db:migrate:d1`. Nothing migrates
  // at runtime. D1 keeps 30 days of point-in-time restore (Time Travel).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lab-inventory",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./drizzle"
    }
  ],
  // Secrets (wrangler secret put): BETTER_AUTH_SECRET, BETTER_AUTH_URL (this
  // Worker's own URL — until it is set the Worker answers 500 and says so).
  // Extra labs beyond the D1-bound primary use DATABASE_URL or LAB_DATABASES,
  // which must be remote libsql:// (Turso) URLs.
  // Nothing per-deployment lives here: the Worker's own URL, the database and
  // the auth secret are secrets, set once in the dashboard or with
  // `wrangler secret put`. That way a deploy from a fork needs no edit to this
  // file, and a fork never diverges from upstream. Until BETTER_AUTH_URL is
  // set the Worker answers 500 with those instructions.
  "vars": {
    // There is no mailer: a password-reset link is a single-use credential, so
    // it must not land in Cloudflare logs. Set to 1 only with a private log
    // sink you control, or wire a real mailer in src/server/auth.ts.
    "LOG_RESET_LINKS": "0"
  }
  // Multi-lab on Workers: set LAB_DATABASES to a JSON array of
  // [{ "id", "name", "url", "token" }] — one Turso database per lab.
  // Admin-UI lab creation is Docker-only (it writes labs.json).
}
